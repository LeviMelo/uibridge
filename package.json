{
  "name": "uibridge",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "A local OpenAI-compatible API backed by chat UI sessions in a real browser",
  "bin": {
    "uibridge": "bin/uibridge.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "examples/_client.py",
    "examples/hello.py",
    "examples/batch.py",
    "examples/durable_batch.py",
    "config.example.json"
  ],
  "scripts": {
    "serve": "node bin/uibridge.mjs serve",
    "login": "node bin/uibridge.mjs login",
    "doctor": "node bin/uibridge.mjs doctor",
    "capture": "node bin/uibridge.mjs capture",
    "test": "node --test test/unit.mjs test/pool.mjs test/window.mjs test/api.mjs test/session.mjs test/reliability.mjs test/report-regressions.mjs",
    "test:acceptance": "node test/acceptance.mjs",
    "test:live": "python test/live.py",
    "serve:headed": "node bin/uibridge.mjs serve --headed"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "openai": "^7.10.0"
  }
}
