# Chrome profiles. These hold YOUR live Google/OpenAI session cookies -
# committing them would publish your logins. Never track this.
.profiles/

node_modules/
__pycache__/
*.pyc

# Run artefacts, not source.
downloads/
.uibridge/
*.log

# Captured DOM/network dumps from probes: large, machine-specific, and they
# can contain conversation content. Fixtures under testdata/ are tracked;
# these subfolders are not.
testdata/dom/
testdata/net/
testdata/downloads/
testdata/capture/
# Recon dumps hold RAW RESPONSE BODIES from a signed-in session, which means
# access tokens and conversation text. They are evidence to read locally,
# never something to commit.
testdata/recon/

# scratch
_*.mjs
