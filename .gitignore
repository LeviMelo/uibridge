# Chrome profiles. These hold YOUR live Google/OpenAI session cookies -
# committing them would publish your logins. Never track this.
.profiles/

node_modules/
__pycache__/
*.pyc

# Run artefacts, not source.
downloads/
.uibridge/
*.log

# Captured DOM/network dumps from probes: large, machine-specific, and they
# can contain conversation content. Fixtures under testdata/ are tracked;
# these subfolders are not.
testdata/dom/
testdata/net/
testdata/downloads/
testdata/capture/
# Recon dumps hold RAW RESPONSE BODIES from a signed-in session, which means
# access tokens and conversation text. They are evidence to read locally,
# never something to commit.
testdata/recon/

# SCRATCH AT THE REPO ROOT. Debug dumps land here constantly while measuring
# a UI - CLI stdout/stderr, DOM fragments, one-off JSON. The pattern is
# anchored with a leading slash so it covers the root only: `examples/_client.py`
# is real, tracked source and must not be swept up by this.
# Previously this was a list of extensions and it kept missing new ones
# (_c.out, _control.html both had to be deleted by hand).
/_*

# Ad-hoc export/run outputs from live acceptance runs.
cexp*.json
gexp*.json
.msg.tmp
